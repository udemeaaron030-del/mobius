# ═══════════════════════════════════════════════════
# MÖBIUS — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this to .env.local and fill in your credentials

# ─── Marketplace (eBay Browse API) — PRIMARY, ACTIVE ───
# Requires: eBay Developer Account with a Production keyset
# Get these from developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ─── Marketplace (AliExpress Dropshipping API) — NOT ACTIVE ───
# Kept for future use; hit an unresolved signature issue during setup.
# Not currently registered in src/lib/marketplace/index.ts.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_APP_STATUS=test

# ─── MÖBIUS Token (Solana) ───
MOBIUS_TOKEN_MINT=
MOBIUS_TREASURY_ADDRESS=
MOBIUS_NETWORK=mainnet-beta
MOBIUS_USD_RATE=0.042

# ─── Post-Launch Buying Lock ───
# Set MOBIUS_LAUNCH_TIMESTAMP to the exact moment the token launches
# (unix milliseconds, e.g. via `Date.now()` in a browser console at
# launch time). Buying stays disabled with a live countdown for
# MOBIUS_BUY_LOCK_HOURS afterward, letting price stabilize and creator
# fees get properly allocated. Leave MOBIUS_LAUNCH_TIMESTAMP empty
# before launch — no countdown shows until there's a real launch time.
MOBIUS_LAUNCH_TIMESTAMP=
MOBIUS_BUY_LOCK_HOURS=3

# ─── Admin ───
# Set this to any password you choose. It protects /admin, the one-click
# "Launch Now" page that starts the buying-lock countdown for everyone.
# Without this set, /admin refuses to work — there's no default password.
ADMIN_SECRET=

# ─── Solana RPC ───
RPC_URL=https://api.mainnet-beta.solana.com

# ─── Delivery Subsidy Config ───
MIN_MOBIUS_BALANCE=1000
MAX_SUBSIDY_PER_ORDER=25
MAX_DAILY_SUBSIDY=5000
MAX_MONTHLY_SUBSIDY=100000
MIN_ORDER_VALUE=0
ELIGIBLE_MARKETPLACES=all
ELIGIBLE_COUNTRIES=all

# ─── Security ───
QUOTE_SIGNING_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (future) ───
DATABASE_URL=
